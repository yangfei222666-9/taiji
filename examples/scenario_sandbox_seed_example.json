    {
      "id": "terrain",
      "type": "environment",
      "role": "mobility risk"
    },
    {
      "id": "dust_storm",
      "type": "environment_event",
      "role": "weather shock"
    },
    {
      "id": "ground_control",
      "type": "observer",
      "role": "delayed command reviewer"
    },
    {
      "id": "solar_charging",
      "type": "resource_flow",
      "role": "energy replenishment"
    }
  ],
  "relationships": [
    {
      "from": "dust_storm",
