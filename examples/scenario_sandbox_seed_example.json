      "from": "terrain",
      "to": "rover",
      "type": "constrains_mobility",
      "evidence": "operator_supplied_example"
    },
    {
      "from": "battery",
      "to": "rover",
      "type": "limits_action_budget",
      "evidence": "operator_supplied_example"
    },
    {
      "from": "ground_control",
      "to": "rover",
      "type": "observes_with_delay",
      "evidence": "operator_supplied_example"
    }
