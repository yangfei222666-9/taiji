# Next.js / Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE=replace-with-service-role-key

# Invite gate
DEMO_REQUIRE_INVITE=true
DEMO_MAX_ACTIVE_RUNS=3
DEMO_RUN_TIMEOUT_SECONDS=30
ARTIFACT_BUCKET=taiji-artifacts
ARTIFACT_TTL_HOURS=24

# Queue mode:
# - mock: local fork smoke path; completes the run without GitHub/GCP.
# - github: production invitation path; dispatches .github/workflows/ephemeral-run.yml.
DEMO_TRIGGER_MODE=mock

# GitHub workflow_dispatch
GH_REPO=owner/repo
GH_TOKEN=github-token-with-actions-write
GH_REF=main
GH_WORKFLOW=ephemeral-run.yml

# Cloud Run Job names used by GitHub Actions.
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1
GCP_ARTIFACT_REPOSITORY=taiji
CLOUD_RUN_JOB=taiji-agent
AGENT_IMAGE_NAME=taiji-agent

# Optional local seed helper. Do not commit a real value.
SUPABASE_DB_URL=postgresql://postgres:password@db.project.supabase.co:5432/postgres
